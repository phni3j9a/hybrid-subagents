{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hybrid Subagents review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overall_correctness",
    "explanation",
    "confidence",
    "findings"
  ],
  "properties": {
    "overall_correctness": {
      "type": "string",
      "enum": [
        "correct",
        "incorrect"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "body",
          "priority",
          "confidence",
          "file_path",
          "line_start",
          "line_end"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "body": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
