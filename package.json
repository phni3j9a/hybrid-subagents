{
  "name": "pi-hybrid-subagents",
  "version": "0.6.0",
  "description": "Hybrid Subagents for Pi: role-based, multi-model specialists powered by pi-subagents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phni3j9a/hybrid-subagents.git"
  },
  "keywords": [
    "pi-package",
    "pi",
    "subagents"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "agents",
    "extensions",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/hybrid-subagents.ts",
      "./node_modules/pi-subagents/bundle/index.js"
    ],
    "skills": [
      "./skills",
      "./node_modules/pi-subagents/skills"
    ],
    "prompts": [
      "./node_modules/pi-subagents/prompts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check"
  },
  "dependencies": {
    "pi-subagents": "0.87.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "^22.19.0",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  },
  "bundleDependencies": [
    "pi-subagents"
  ]
}
